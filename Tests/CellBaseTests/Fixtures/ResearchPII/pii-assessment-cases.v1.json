      "request": {
        "fields": [
          {
            "name": "count",
            "kind": "count"
          }
        ],
        "answerForm": "aggregate",
        "populationSize": 100,
        "bucket": "day",
        "retentionDays": 1000
      },
      "expect": {
        "degree": "aggregate",
        "violations": [
          "retention_too_long"
        ]
      }
    },
