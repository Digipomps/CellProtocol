        },
        "subTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WeightOfEntityRepresentation"
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WeightOfEntityRepresentation"
          }
        },
        "partOf": {
          "type": "array",
