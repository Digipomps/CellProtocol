{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:haven:review:entity-representation:2026-09-11",
  "title": "EntityRepresentation – den felles vektede nodemodellen",
  "$ref": "#/$defs/EntityRepresentation",
  "$defs": {
    "WeightOfEntityRepresentation": {
      "type": "object",
      "properties": {
        "weight": {
          "type": "number"
        },
        "value": {
          "$ref": "#/$defs/EntityRepresentation"
        },
        "reference": {
          "type": "string"
        }
      },
      "required": [
        "weight"
      ],
      "additionalProperties": true,
      "anyOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "reference"
          ]
        }
      ],
      "description": "Weight<EntityRepresentation>. Inline value eller referanse til en eksisterende node av samme type. Encoder velger én. Ved gjentakelse/sirkel bruker Codable samme typede ID-register via userInfo og skriver referansen. Ett registersett per dokument. Referanseoppløsning kontrolleres av runtime; vekt er ikke en sannsynlighet eller et Grant."
    },
