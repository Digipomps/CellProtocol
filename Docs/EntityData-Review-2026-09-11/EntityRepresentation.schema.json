          }
        },
        "interests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WeightOfInterest"
          }
        },
        "purposes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WeightOfPurpose"
