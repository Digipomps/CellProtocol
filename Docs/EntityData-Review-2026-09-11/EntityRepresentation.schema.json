          "type": "object",
          "additionalProperties": true,
          "description": "Eierprivat Entity/Object med eierens kunnskap. Kun eksplisitt eierprivat kodek bevarer feltet. Ingen automatisk delingsrett."
        },
        "projectionSource": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
