            "placeholder": "Sportittel",
            "modifiers": {
              "localization": {
                "placeholder": {
                  "namespace": "demo",
                  "key": "placeholder"
                }
              }
            }
          }
        },
        {
          "Button": {
            "keypath": "demo.save",
            "label": "Lagre",
            "payload": {
              "kind": "track"
            },
            "modifiers": {
              "localization": {
                "label": {
                  "namespace": "demo",
                  "key": "save"
                }
              }
            }
          }
        },
